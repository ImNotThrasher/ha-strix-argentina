{
  "info": {
    "_postman_id": "146d0523-de09-4664-9671-4af18978f5a1",
    "name": "Strix Argentina API (read-only)",
    "description": "Unofficial, read-only Strix Argentina API collection for developers. Authenticate using OAuth, refresh tokens, and list vehicles. Set collection variables locally before use. oauth_basic is the OAuth client credential without the 'Basic ' prefix; it is not your account password. client_device_id is optional and is disabled in requests by default. Never commit real credentials, tokens, device IDs, or vehicle responses. API endpoints may change without notice.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "28681801"
  },
  "item": [
    {
      "name": "01 - Authenticate (password)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json();",
              "  pm.test('Access token is present', () => {",
              "    pm.expect(data.access_token).to.be.a('string').and.not.empty;",
              "  });",
              "  if (typeof data.access_token === 'string' && data.access_token) {",
              "    pm.collectionVariables.set('access_token', data.access_token);",
              "  }",
              "  if (typeof data.refresh_token === 'string' && data.refresh_token) {",
              "    pm.collectionVariables.set('refresh_token', data.refresh_token);",
              "  }",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Basic {{oauth_basic}}"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "grant_type",
              "value": "password"
            },
            {
              "key": "username",
              "value": "{{username}}"
            },
            {
              "key": "password",
              "value": "{{password}}"
            },
            {
              "key": "client_device_id",
              "value": "{{client_device_id}}",
              "disabled": true,
              "description": "Optional device identifier. Enable this field only if your Strix client requires it."
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/oauth/token",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "oauth",
            "token"
          ]
        },
        "description": "Get an OAuth access token using your Strix account credentials. Requires username, password, and oauth_basic. oauth_basic must contain only the encoded client credential, without the 'Basic ' prefix. client_device_id is optional and disabled by default. On success, saves access_token and refresh_token as collection variables."
      },
      "response": []
    },
    {
      "name": "02 - Refresh token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json();",
              "  pm.test('Access token is present', () => {",
              "    pm.expect(data.access_token).to.be.a('string').and.not.empty;",
              "  });",
              "  if (typeof data.access_token === 'string' && data.access_token) {",
              "    pm.collectionVariables.set('access_token', data.access_token);",
              "  }",
              "  if (typeof data.refresh_token === 'string' && data.refresh_token) {",
              "    pm.collectionVariables.set('refresh_token', data.refresh_token);",
              "  }",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Basic {{oauth_basic}}"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "grant_type",
              "value": "refresh_token"
            },
            {
              "key": "refresh_token",
              "value": "{{refresh_token}}"
            },
            {
              "key": "client_device_id",
              "value": "{{client_device_id}}",
              "disabled": true,
              "description": "Optional device identifier. Enable this field only if your Strix client requires it."
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/oauth/token",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "oauth",
            "token"
          ]
        },
        "description": "Renew an access token using the refresh_token saved by the login request. Requires oauth_basic and refresh_token. client_device_id is optional and disabled by default. On success, updates collection token variables."
      },
      "response": []
    },
    {
      "name": "03 - List vehicles",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  pm.test('Response is an array', () => {",
              "    pm.expect(pm.response.json()).to.be.an('array');",
              "  });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/things",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "things"
          ]
        },
        "description": "Read the list of vehicles and their available status data. Requires access_token from login or refresh. Responses may include private vehicle identifiers and locations; do not save or publish real responses."
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "https://api.strix.com.ar",
      "description": "Strix API base URL."
    },
    {
      "key": "username",
      "value": "",
      "description": "Your Strix account username. Keep private.",
      "type": "secret"
    },
    {
      "key": "password",
      "value": "",
      "description": "Your Strix account password. Keep private.",
      "type": "secret"
    },
    {
      "key": "oauth_basic",
      "value": "",
      "description": "OAuth client credential (encoded portion only, without 'Basic '). Not your account password.",
      "type": "secret"
    },
    {
      "key": "client_device_id",
      "value": "",
      "description": "Optional device identifier; leave blank unless needed and enable the request body field to send it."
    },
    {
      "key": "access_token",
      "value": "",
      "description": "Automatically populated by successful OAuth requests. Keep private.",
      "type": "secret"
    },
    {
      "key": "refresh_token",
      "value": "",
      "description": "Automatically populated by successful OAuth requests. Keep private.",
      "type": "secret"
    }
  ]
}
